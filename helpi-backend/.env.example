# =============================================================
# HELPI - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env com segredos no repositório!
# =============================================================

# Porta do servidor
PORT=3000

# Ambiente (development | production | test)
NODE_ENV=development

# URL de conexão com o PostgreSQL (Neon, Supabase, local, etc.)
DATABASE_URL='postgresql://usuario:senha@host:porta/nome_banco?sslmode=require'

# Chave secreta para assinatura dos tokens JWT (use algo forte e aleatório)
# Dica: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_chave_secreta_aqui

# Configurações opcionais do pool de conexões
DB_POOL_MAX=20
